# ─────────────────────────────────────────────
# آرتیوو — متغیرهای محیطی
# این فایل را به .env کپی کن و مقادیر را پر کن.
# هیچ کلیدی در ریپو کامیت نمی‌شود. (.env در .gitignore است)
# فرمت: متغیرهای NUXT_* به runtimeConfig در nuxt.config.ts نگاشت می‌شوند.
# ─────────────────────────────────────────────

# ── نقشه‌ی نشان (Neshan) ──
# REST API نشان — فقط سمت سرور (ژئوکد معکوس در /api/neshan/reverse).
# هرگز به کلاینت نمی‌رود. خالی = پاسخ graceful بدون نشانی (ورود دستی).
NUXT_NESHAN_API_KEY=""

# کلید وب SDK نقشه (عمومی — در باندل کلاینت دیده می‌شود).
# خالی بودن یعنی نقشه با جایگزین بدون‌کلید ('none' provider) اجرا می‌شود.
NUXT_PUBLIC_NESHAN_MAP_KEY=""

# اختیاری — ارائه‌دهنده‌ی نقشه: 'neshan' (پیش‌فرض) یا 'none'
# NUXT_PUBLIC_NESHAN_PROVIDER="neshan"

# اختیاری — آدرس SDK نشان (پیش‌فرض: v1.1.0 روی static.neshan.org)
# NUXT_PUBLIC_NESHAN_SDK_URL="https://static.neshan.org/maps/neshan-map-v1.1.0.js"
# NUXT_PUBLIC_NESHAN_SDK_CSS="https://static.neshan.org/maps/neshan-map-v1.1.0.css"

# ── پیامک کاوه‌نگار (OTP) ──
# کلید API از پنل کاوه‌نگار — فقط سمت سرور؛ required در production
# (بدون این کلید، ارسال OTP در production با خطای صریح ۵۰۰ مواجه می‌شود)
NUXT_KAVENEGAR_API_KEY=""

# نام قالب تأییدشده‌ی OTP در کاوه‌نگار (مثلاً "artivo-otp")
NUXT_KAVENEGAR_OTP_TEMPLATE=""

# خط ارسال (اختیاری)
NUXT_KAVENEGAR_SENDER=""

# ⚠️ حالت توسعه: با `nuxt dev` کد OTP همیشه 1111 است و پیامکی ارسال
# نمی‌شود (فقط در کنسول سرور چاپ می‌شود). در production (nuxt build)
# این رفتار غیرفعال است و ارسال واقعی فقط با کلیدهای بالا انجام می‌شود.
# راهنمای حالت توسعه در UI ورود با متغیر زیر کنترل می‌شود
# (به‌صورت خودکار با NODE_ENV تغییر می‌کند — معمولاً لازم نیست دستی ست شود):
# NUXT_PUBLIC_AUTH_DEV_MODE="true"

# ── پایگاه‌داده ──
# هنوز دیتابیس وجود ندارد؛ داده‌ی توسعه در .data/artivo.json ذخیره می‌شود
# (gitignore شده). وقتی بک‌اند واقعی اضافه شد، رشته‌ی اتصال این‌جا قرار می‌گیرد.
# DATABASE_URL=""
