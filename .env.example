# ── Neshan Maps ──────────────────────────────────────────────
# کلید وب SDK نشان (برای نمایش نقشه‌ی تعاملی در مرورگر)
# از پنل developer.neshan.org → «وب سرویس و SDK» دریافت کنید.
NUXT_PUBLIC_NESHAN_MAP_KEY=

# کلید REST API نشان (فقط سمت سرور — هرگز به مرورگر نمی‌رود)
# برای ژئوکد معکوس در فرم «افزودن لوکیشن» استفاده می‌شود.
NUXT_NESHAN_API_KEY=

# اختیاری — آدرس SDK و ارائه‌دهنده (برای تغییر نقشه‌ساز در آینده)
# NUXT_PUBLIC_NESHAN_SDK_URL=https://static.neshan.org/maps/neshan-map-v1.1.0.js
# NUXT_PUBLIC_NESHAN_SDK_CSS=https://static.neshan.org/maps/neshan-map-v1.1.0.css
# NUXT_PUBLIC_NESHAN_PROVIDER=neshan
