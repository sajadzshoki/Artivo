# ─────────────────────────────────────────────
# آرتیوو — متغیرهای محیطی
# این فایل را به .env کپی کن و مقادیر را پر کن.
# هیچ کلیدی در ریپو کامیت نمی‌شود.
# ─────────────────────────────────────────────

# ── نقشه‌ی نشان ──
# REST API نشان — فقط سمت سرور (ژئوکد معکوس). هرگز به کلاینت نمی‌رود.
NUXT_NESHAN_API_KEY=""
# کلید وب SDK نقشه (عمومی) — خالی بودن یعنی نقشه با جایگزین بدون‌کلید اجرا می‌شود
NUXT_PUBLIC_NESHAN_MAP_KEY=""

# ── پیامک کاوه‌نگار (OTP) ──
# کلید API از پنل کاوه‌نگار — فقط سمت سرور؛ required در production
NUXT_KAVENEGAR_API_KEY=""
# نام قالب تأییدشده‌ی OTP در کاوه‌نگار (مثلاً "artivo-otp")
NUXT_KAVENEGAR_OTP_TEMPLATE=""
# خط ارسال (اختیاری)
NUXT_KAVENEGAR_SENDER=""

# ⚠️ حالت توسعه: با `nuxt dev` کد OTP همیشه 1111 است و پیامکی ارسال
# نمی‌شود. در production (nuxt build) این رفتار غیرفعال است و ارسال
# واقعی فقط با کلیدهای بالا انجام می‌شود — بدون کلید، خطای صریح می‌دهد.
